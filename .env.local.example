# DemoDay local settings. Copy this file to .env.local and fill in the values.
# .env.local contains secrets: never commit or share it.
# After any change, restart the server (Ctrl+C, then: make dev).

# 1. Scoring API
# Which API scores the videos (choose one):
#   gemini  Google AI Studio. Needs GEMINI_API_KEY (section 1a).
#   vertex  Google Cloud Vertex AI. Needs VERTEX_SERVICE_ACCOUNT_FILE (section 1b).
AI_PROVIDER=gemini

# Model used by either API.
GEMINI_MODEL=gemini-3.8-flash

# 1a. Google AI Studio (used when AI_PROVIDER=gemini)
# API key from https://aistudio.google.com. The free tier allows only about 20 scorings per day;
# enable billing for real events.
GEMINI_API_KEY=

# 1b. Vertex AI (used when AI_PROVIDER=vertex)
# Path to the service-account key file (JSON). Keep the file outside the project folder.
# The service account needs the "Vertex AI User" role in its Google Cloud project.
# VERTEX_SERVICE_ACCOUNT_FILE=~/.config/demoday/vertex-service-account.json
# Optional (defaults shown). Videos larger than VERTEX_INLINE_MAX_MB cannot be scored on Vertex;
# use AI_PROVIDER=gemini for those.
# VERTEX_PROJECT=(project_id from the key file)
# VERTEX_LOCATION=global
# VERTEX_INLINE_MAX_MB=80

# 1c. Scoring tuning, both APIs (optional; defaults shown)
# GEMINI_SCORING_TIMEOUT_S=120
# GEMINI_TEMPERATURE=0.2
# GEMINI_THINKING_BUDGET=4096
# GEMINI_VIDEO_FPS=1

# 2. Google Drive (batch evaluation)
# API key with the Google Drive API enabled (one line, not a JSON key file).
# Team folders must be shared as "Anyone with the link". The folder link itself is pasted
# on the Batches page, not configured here.
GOOGLE_DRIVE_API_KEY=

# 3. App (optional; defaults shown)
# DATA_DIR=./data
# MAX_UPLOAD_MB=1024

# 4. Reserved: read by nothing yet
# Sign-in (pending story).
# SESSION_SECRET=
# Service account for private Drive folders (designed, not built).
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative providers named in tech-spec.md (not built).
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
